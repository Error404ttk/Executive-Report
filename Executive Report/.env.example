NODE_ENV=production
WEB_PORT=3012
API_PORT=3013
APP_URL=https://reports.example.go.th

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-character-secret
SESSION_TTL_SECONDS=28800

# Gemini API
GEMINI_API_KEY=replace-with-gemini-api-key

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=executive_report
DB_PASSWORD=replace-with-strong-db-password
DB_NAME=executive_report

# Runtime storage. Keep this outside dist so uploads survive rebuilds.
UPLOAD_DIR=/var/lib/executive-report/uploads
TMP_DIR=/tmp/executive-report
MAX_UPLOAD_BYTES=52428800

# First-run seed users. These are required in production and used only when the users table is empty.
DEFAULT_ADMIN_EMAIL=admin@example.go.th
DEFAULT_ADMIN_PASSWORD=replace-with-strong-admin-password
DEFAULT_EXEC_EMAIL=executive@example.go.th
DEFAULT_EXEC_PASSWORD=replace-with-strong-executive-password
DEFAULT_USER_EMAIL=user@example.go.th
DEFAULT_USER_PASSWORD=replace-with-strong-user-password
